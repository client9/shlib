# Default: normalize text in the repo, check it out with LF everywhere.
#
# Git on Windows defaults to core.autocrlf=true.  A shell script with CRLF
# fails in ways that look like anything but line endings, so pin the whole
# tree rather than listing extensions and missing one.
* text=auto eol=lf

# Test fixtures must be byte-exact: their checksums are the assertion.
# Without this, Windows checks them out as CRLF and every hash test fails
# with a digest that looks arbitrary (md5 of "foobar\r\n" instead of
# "foobar\n").  -text disables end-of-line conversion entirely.
fixtures/** -text

# Generated bundles are shell; keep them LF for the same reason.
dist/* text eol=lf
